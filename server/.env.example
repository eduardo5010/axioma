# Copie para .env (na pasta server/) e preencha.

# --- Mercado Pago ------------------------------------------------------------
# Nacional (site mercadopago.com.br) → "Seus integrações" / "Desenvolvedores" → Credenciais.
# PUBLIC KEY e ACCESS TOKEN são diferentes um do outro. O ACCESS TOKEN é SECRETO,
# nunca coloque no código do navegador.
MP_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-000000000000000000000000000000

# URL pública do site (onde o navegador roda), sem barra final. O Mercado Pago usa
# para voltar o jogador depois de autorizar a assinatura.
# Atenção: o MP rejeita "localhost" — em dev use http://127.0.0.1:5174 (o código troca sozinho).
# Em produção: https://seu-dominio.com
MP_BACK_URL=http://127.0.0.1:5174

# Segredo de notificações: Console MP → "Seus integrações" → Aplicação → "Configurações"
# → "Notificações de webhooks" → gerar segredo. Usado para validar que o aviso veio do MP.
# Vazio = sem validação (evite em produção).
MP_WEBHOOK_SECRET=

# Preço padrão do plano de apoio (BRL/mês).
MP_PRECO_DEFAULT=5

# Sandbox: email do USUÁRIO DE TESTE (comprador) usado como payer_email da assinatura.
# Obrigatório quando as credenciais forem de teste e o usuário do app tiver conta MP real
# (o MP exige que pagador e cobrador sejam ambos reais ou ambos de teste).
MP_SANDBOX_PAYER_EMAIL=

# --- Firebase Admin (verifica o token de login — Auth) --------------------------
# O servidor usa a conta de serviço SOMENTE para validar o token do Firebase Auth
# (o banco de dados agora é o Postgres/Neon, abaixo). Crie a conta de serviço:
# Console Firebase → Configurações do projeto → Contas de serviço →
# "Gerar nova chave privada". Em dev, salve o JSON e aponte o caminho aqui:
GOOGLE_APPLICATION_CREDENTIALS=../axioma-d256e-firebase-adminsdk-fbsvc-e28adc0cd3.json
#
# Em produção (Railway/outra nuvem) não existe caminho de arquivo: cole aqui o
# CONTEÚDO inteiro do JSON da conta de serviço (uma linha). Se preenchido, tem
# prioridade sobre GOOGLE_APPLICATION_CREDENTIALS.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}

# --- Banco de dados (Neon/Postgres) ---------------------------------------------
# Connection string do Neon (Dashboard → seu projeto → Connect → "Connection string"
# → Pru .NET/Node → "Unrestricted" / sem "Pooled"). Ex.:
#   postgresql://user:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb
# O navegador NUNCA acessa isso: somente o servidor Express usa.
DATABASE_URL=

# UIDs autorizados a mudar o status de QUALQUER proposta (separados por vírgula).
# Sem isso, só o autor muda o status da própria proposta.
ADMIN_UIDS=

# Porta HTTP do servidor (o Vite faz proxy de /api para cá em dev).
PORT=3000

# --- Análise de propostas por IA (Gemini) -------------------------------------
# Chave de API gratuita: https://aistudio.google.com/apikey → "Create API key".
# Sem ela, as propostas entram na votação mas ficam sem a análise automática
# (o front mostra "Análise pendente" e o botão de gerar/reanalisar).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Tentativas (com intervalo) contra 429/503 da cota gratuita.
GEMINI_TENTATIVAS=5

# Quantas propostas por dia um mesmo navegador (sem conta) pode lançar.
# Protege a cota gratuita da IA contra spam.
PROPOSTAS_DISPOSITIVO_DIA=3