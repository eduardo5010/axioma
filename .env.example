# Copie este arquivo para `.env.local` e preencha com os valores do seu projeto
# Firebase (Console do Firebase > Configurações do projeto > Seus apps > Web).
# Nenhuma dessas chaves é secreta ao cliente, mas NUNCA as commit no repositório.

VITE_FIREBASE_API_KEY=AIzaSy_xxx
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_APP_ID=1:xxxx:web:xxxx

# Opcionais:
# VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890

# UIDs do Firebase Auth (separados por vírgula) autorizados a mudar o status de
# propostas na votação. Sem isso, apenas o autor muda o status da própria proposta.
VITE_ADMIN_UIDS=